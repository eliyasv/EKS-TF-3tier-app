pipeline {
    agent any
    parameters {
        string(name: 'IMAGE_TAG', defaultValue: '', description: 'Image tag created by CI, e.g. 123-abcd123')
        choice(name: 'COMPONENT', choices: ['frontend', 'backend', 'both'], description: 'Which component manifest to update')
        string(name: 'TARGET_BRANCH', defaultValue: 'main', description: 'Target branch for the GitOps manifest update')
    }
    environment {
        AWS_ACCOUNT_ID = credentials('ACCOUNT_ID')
        AWS_DEFAULT_REGION = 'us-east-1'
        ECR_REPO_BASE = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"
        GIT_REPO_NAME = 'EKS-TF-3tier-app'
        GIT_USER_NAME = 'eliyasv'
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: "${params.TARGET_BRANCH}", credentialsId: 'GITHUB', url: 'https://github.com/eliyasv/EKS-TF-3tier-app.git'
            }
        }
        stage('Validate Inputs') {
            steps {
                script {
                    if (!params.IMAGE_TAG?.trim()) {
                        error 'IMAGE_TAG is required for a GitOps release.'
                    }
                }
            }
        }
        stage('Update GitOps Manifests') {
            steps {
                script {
                    def imageTag = params.IMAGE_TAG.trim()
                    def component = params.COMPONENT
                    def releaseBranch = "gitops-release/${component}-${imageTag}"
                    sh "git checkout -b ${releaseBranch}"

                    if (component == 'backend' || component == 'both') {
                        dir('k8s/backend') {
                            sh "sed -i 's|image: .*backend:.*|image: ${env.ECR_REPO_BASE}/backend:${imageTag}|' deployment.yaml"
                            sh 'git add deployment.yaml'
                        }
                    }
                    if (component == 'frontend' || component == 'both') {
                        dir('k8s/frontend') {
                            sh "sed -i 's|image: .*frontend:.*|image: ${env.ECR_REPO_BASE}/frontend:${imageTag}|' deployment.yaml"
                            sh 'git add deployment.yaml'
                        }
                    }

                    def changes = sh(script: 'git diff --cached --quiet || echo CHANGED', returnStdout: true).trim()
                    if (!changes) {
                        error 'No manifest changes detected. Release branch will not be created.'
                    }

                    sh "git commit -m 'GitOps release: ${component} image ${imageTag}'"
                    env.RELEASE_BRANCH = releaseBranch
                    withCredentials([usernamePassword(credentialsId: 'GITHUB',
                        usernameVariable: 'GITHUB_USERNAME', passwordVariable: 'GITHUB_TOKEN')]) {
                        sh '''
                            set +x
                            set -eu
                            RELEASE_AUTH_DIR=$(mktemp -d)
                            trap 'rm -f "$RELEASE_AUTH_DIR/askpass"; rmdir "$RELEASE_AUTH_DIR"' EXIT
                            cat > "$RELEASE_AUTH_DIR/askpass" <<'ASKPASS'
                            #!/bin/sh
                            case "$1" in
                                *Username*) printf '%s\\n' "$GITHUB_USERNAME" ;;
                                *Password*) printf '%s\\n' "$GITHUB_TOKEN" ;;
                                *) exit 1 ;;
                            esac
                            ASKPASS
                            chmod 700 "$RELEASE_AUTH_DIR/askpass"
                            export GIT_ASKPASS="$RELEASE_AUTH_DIR/askpass"
                            export GIT_TERMINAL_PROMPT=0
                            git -c credential.helper= push \
                                "https://github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git" \
                                "HEAD:$RELEASE_BRANCH"
                        '''.stripIndent()
                    }

                    echo "Created release branch: ${releaseBranch}"
                }
            }
        }
        stage('Create Pull Request') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'GITHUB',
                        usernameVariable: 'GITHUB_USERNAME', passwordVariable: 'GITHUB_TOKEN')]) {
                        sh '''
                            set +x
                            set -eu
                            umask 077
                            PR_REQUEST_DIR=$(mktemp -d)
                            trap 'rm -f "$PR_REQUEST_DIR/payload.json" "$PR_REQUEST_DIR/response.json"; rmdir "$PR_REQUEST_DIR"' EXIT
                            python3 - <<'PY' > "$PR_REQUEST_DIR/payload.json"
                            import json
                            import os
                            component = os.environ["COMPONENT"]
                            tag = os.environ["IMAGE_TAG"].strip()
                            print(json.dumps({
                                "title": f"GitOps release: {component} image {tag}",
                                "head": os.environ["RELEASE_BRANCH"],
                                "base": os.environ["TARGET_BRANCH"],
                                "body": f"This PR updates the Kubernetes manifests for {component} to use image tag {tag}."
                            }))
                            PY
                            printf 'header = "Authorization: Bearer %s"\\n' "$GITHUB_TOKEN" |
                                curl --config - --fail-with-body --silent --show-error \
                                    --request POST \
                                    --header "Content-Type: application/json" \
                                    --data-binary "@$PR_REQUEST_DIR/payload.json" \
                                    --output "$PR_REQUEST_DIR/response.json" \
                                    "https://api.github.com/repos/${GIT_USER_NAME}/${GIT_REPO_NAME}/pulls"
                            python3 - "$PR_REQUEST_DIR/response.json" <<'PY'
                            import json
                            import sys
                            with open(sys.argv[1]) as response:
                                result = json.load(response)
                            if not result.get("number") or not result.get("html_url"):
                                raise SystemExit("GitHub response did not confirm PR creation.")
                            print("Created pull request:", result["html_url"])
                            PY
                        '''.stripIndent()
                    }
                }
            }
        }
    }
    post {
        success {
            echo 'GitOps release pipeline completed successfully.'
        }
        failure {
            echo 'GitOps release pipeline failed. Inspect the logs for details.'
        }
    }
}
